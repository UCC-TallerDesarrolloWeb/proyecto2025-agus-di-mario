# Convención del proyecto: LF + indentación con tabs.
# WebStorm/VS Code leen este archivo automáticamente al reformatear.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = tab

# Markdown usa espacios: la indentación tiene significado semántico
# (listas anidadas, bloques de código) y los tabs rompen el render.
[*.md]
indent_style = space
indent_size = 2

[*.{yml,yaml}]
indent_style = space
indent_size = 2
